DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Order agent. Replay (the default) needs no key; live needs ANTHROPIC_API_KEY.
AGENT_MODE=replay
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Shift Watch reads driver messages and proposal text and answers the operator chat. Same accuracy on
# Sonnet and Opus in our tests, and Sonnet is about twice as fast, so it stays on Sonnet.
SHIFT_WATCH_MODEL=claude-sonnet-5-5
# The demo clock starts here when the server starts (defaults to the dataset snapshot).
DEMO_CLOCK_START=2026-10-21T09:00:00Z
